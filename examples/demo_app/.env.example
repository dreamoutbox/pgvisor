# ==============================================================================
# PgVisor Demo App Environment Configuration
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# PostgreSQL Connection (points to PgVisor L7 Proxy)
# In Docker network: use 'pgvisor-proxy'
# Outside Docker (local dev): use '127.0.0.1'
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# Optional: full connection string (overrides individual DB_* variables if set)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Application Settings
SECRET_KEY=dev-secret-key-pgvisor-demo
PORT=5000
DEBUG=false
