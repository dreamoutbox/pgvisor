# ==============================================================================
# PgVisor Cluster Configuration
# Copy this file to .env before running: cp .env.example .env
# ==============================================================================

# PgVisor Docker image tag (Docker Hub prebuilt image or built from source)
PGVISOR_IMAGE=dreamoutbox/pgvisor:latest

# Cluster identifier (unique string identifying this Raft cluster)
PGVISOR_CLUSTER_ID=pgvisor-cluster

# Host port mappings
PGVISOR_PORT=5432
PGVISOR_DASHBOARD_PORT=8080

# Web Dashboard Bearer Token Authentication
PGVISOR_ADMIN_TOKEN=postgres

# PostgreSQL Superuser
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# S3 Backup Storage Settings (Default: bundled MinIO / RustFS container)
# To use AWS S3, set S3_ENDPOINT=https://s3.<region>.amazonaws.com
# To use Cloudflare R2, set S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=http://minio:9000
S3_BUCKET=pgvisor-backups
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Local MinIO / RustFS ports
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

# Logging level (error, warn, info, debug, trace)
RUST_LOG=info
